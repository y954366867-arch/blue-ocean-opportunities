{
  "name": "white-label-research-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify:data": "tsx --env-file=.env.local scripts/verify-data.ts",
    "format": "prettier --write app lib scripts tests"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "next": "16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
